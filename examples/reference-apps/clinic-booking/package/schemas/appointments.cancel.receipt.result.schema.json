{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt of appointments.cancel (appointments_cancel_commit, appointments_cancel_status)",
  "description": "The recorded outcome of a cancellation: the appointment reference, its status (cancelled), the local start, the patient and the doctor. identifiers are the appointment and the queued notification; follow_up is the queued cancellation message. A repeated commit and status return this same receipt; status answers with one validation_failed on idempotency_key when nothing is recorded for the key.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "identifiers",
    "values",
    "errors",
    "allowed_next_actions"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "rejected",
        "unavailable"
      ]
    },
    "identifiers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_type",
          "entity_id"
        ],
        "properties": {
          "entity_type": {
            "enum": [
              "appointment",
              "notification"
            ]
          },
          "entity_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "values": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "appointment_reference"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "appointment_status"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "appointment_starts_at"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "datetime"
                  },
                  "value": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "zone": {
                    "type": "string",
                    "maxLength": 64
                  }
                }
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "patient_name"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "doctor_name"
              },
              "value": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "text"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  }
                }
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        ]
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "conflict",
              "expired",
              "internal",
              "missing_fields",
              "permission_denied",
              "scope_missing",
              "scope_violation",
              "stale",
              "unavailable",
              "validation_failed"
            ]
          },
          "field": {
            "type": "string",
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "version"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "string",
          "pattern": "^rv1-[0-9a-f]{32}$"
        }
      }
    },
    "allowed_next_actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "enum": [
              "invoke_capability",
              "retry"
            ]
          },
          "capability_id": {
            "enum": [
              "appointments.book"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "follow_up": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "state"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "unknown"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "preparation": false
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "freshness"
        ],
        "properties": {
          "errors": {
            "maxItems": 0
          },
          "values": {
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "appointment_reference"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "appointment_status"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "appointment_starts_at"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "patient_name"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "field"
                  ],
                  "properties": {
                    "field": {
                      "const": "doctor_name"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          },
          "identifiers": {
            "maxItems": 0
          },
          "values": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          },
          "identifiers": {
            "maxItems": 0
          },
          "values": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
