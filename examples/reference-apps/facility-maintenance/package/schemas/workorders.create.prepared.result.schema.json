{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result of workorders.create prepare",
  "description": "The prepared action: the exact effects, the data versions relied on (each record with its own revision), a validity period of 120 seconds and the facts the confirmation must state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "identifiers",
    "values",
    "errors",
    "allowed_next_actions"
  ],
  "properties": {
    "status": {
      "enum": [
        "ok",
        "rejected",
        "unavailable"
      ]
    },
    "identifiers": {
      "type": "array",
      "maxItems": 0
    },
    "values": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "asset_name"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "work_order_title"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "value"
            ],
            "properties": {
              "field": {
                "const": "priority"
              },
              "value": {
                "$ref": "#/$defs/text"
              },
              "display": {
                "type": "string",
                "maxLength": 2048
              }
            }
          }
        ]
      }
    },
    "errors": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "conflict",
              "expired",
              "internal",
              "missing_fields",
              "permission_denied",
              "scope_missing",
              "scope_violation",
              "stale",
              "unauthenticated",
              "unavailable",
              "validation_failed"
            ]
          },
          "field": {
            "type": "string",
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "version"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
        },
        "version": {
          "type": "string",
          "pattern": "^rv1-[0-9a-f]{32}$"
        }
      }
    },
    "allowed_next_actions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "enum": [
              "cancel",
              "confirm",
              "continue_in_app",
              "retry"
            ]
          },
          "capability_id": {
            "type": "string",
            "maxLength": 64
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "effects",
        "data_versions",
        "declared_risk_level",
        "valid_for_seconds"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "operation",
              "entity_type",
              "description",
              "changes",
              "external"
            ],
            "properties": {
              "operation": {
                "enum": [
                  "create",
                  "update",
                  "delete",
                  "send",
                  "other"
                ]
              },
              "entity_type": {
                "enum": [
                  "work_order"
                ]
              },
              "entity_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "changes": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "value"
                  ]
                }
              },
              "external": {
                "type": "boolean"
              }
            }
          }
        },
        "data_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entity_type",
              "entity_id",
              "version"
            ],
            "properties": {
              "entity_type": {
                "type": "string",
                "maxLength": 64
              },
              "entity_id": {
                "type": "string",
                "maxLength": 128
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "declared_risk_level": {
          "const": 1
        },
        "valid_for_seconds": {
          "const": 120
        }
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "integer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "integer"
        },
        "value": {
          "type": "integer"
        }
      }
    },
    "boolean": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "identifier"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "decimal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "decimal"
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,9})?$"
        }
      }
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value",
        "currency"
      ],
      "properties": {
        "kind": {
          "const": "money"
        },
        "value": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]{0,17})(\\.[0-9]{1,9})?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "datetime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "datetime"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,9})?Z$"
        },
        "zone": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  }
}
