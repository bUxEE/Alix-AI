# Copy to .env (git-ignored) and edit. Compose reads it for variable interpolation only; nothing here is forwarded
# to a container except through the entries in compose.yaml. No secret is stored in this file.

# The key AlixAI presents to the CLM service. The service compares it to the Authorization: Bearer header.
# Generate one:  openssl rand -hex 32
# entrypoint.sh refuses the placeholder, whitespace and anything under 32 characters. NOTE: the CLM adapter of
# AlixAI (adapters/decision/clm, D-14) sends this key as a Bearer header from its api_key_ref (env: or file:), so keep a real key here.
# ALIXAI_CLM_ALLOW_NO_KEY=true is only for a manual loopback-only experiment without AlixAI.
CLM_API_KEY=change-me-generate-with-openssl-rand-hex-32
ALIXAI_CLM_ALLOW_NO_KEY=false

# Host port of the CLM service, always published on 127.0.0.1 only.
CLM_PORT=8700

# Registry entry ids (models/registry/<id>.yaml) for the CLM head and the Qwen3-8B encoder. D-11 adds them; the
# sidecar refuses to start while an entry is missing, rejected, retired or disagrees with config/pins.txt.
ALIXAI_CLM_REGISTRY_ID=clm-v0.1-8b
ALIXAI_ENCODER_REGISTRY_ID=qwen3-8b

# Threads and KV cache of the unconstrained run. The profile files carry their own values; leave these unset
# when you use one.
# CLM_VLLM_THREADS=4
# CLM_CLM_THREADS=2
# CLM_VLLM_KV_GIB=2

# Embedding cache of the CLM service: an absolute size, or 0 to switch it off.
CLM_ACTION_CACHE=256MiB
