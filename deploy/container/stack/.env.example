# Copy to .env (git-ignored) and edit. Compose reads it for variable interpolation only.

# REQUIRED. The single shared key AlixAI uses to call LocalAI; a legacy LocalAI key is full admin.
# Generate one:  openssl rand -hex 32
# The LocalAI guard (entrypoint.sh) refuses to start with this placeholder, a value under 32 characters,
# or whitespace/commas.
LOCALAI_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Host loopback port the API is published on (always 127.0.0.1; a remote listener is a reverse proxy
# with TLS in front of this port, README.md "Reaching the API").
ALIXAI_PORT=7470

# Directory holding LocalAI's models.yaml and backend-gallery.yaml, read-only in the container. Default is the
# M0-08 pinned catalogue; point it at a directory with your approved model definitions (README.md "Models").
# ALIXAI_LOCALAI_CONFIG=../localai/config

# Backends LocalAI expects to find installed: names from backend-gallery.yaml. Provision them on the host first.
LOCALAI_EXTERNAL_BACKENDS=cpu-llama-cpp

# Unload an idle backend after this long (Go duration).
LOCALAI_WATCHDOG_IDLE_TIMEOUT=15m

# Leave unset: each profile file carries the resident-backend default of its profile
# (lite 2, balanced 4, 4g 1). Never set it below the models your configuration keeps resident.
# LOCALAI_MAX_ACTIVE_BACKENDS=2

# Upstream strict backend integrity. Leave false (deploy/container/localai/hardening.md section 4).
LOCALAI_REQUIRE_BACKEND_INTEGRITY=false
