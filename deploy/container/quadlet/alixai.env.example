# Copy to ~/.config/alixai/alixai.env, chmod 0600, and edit. Read by the alixai and alixai-localai units.
# The single shared key AlixAI uses to call LocalAI; a legacy LocalAI key is full admin.
# Generate one:  openssl rand -hex 32
# The LocalAI guard refuses to start with this placeholder, a value under 32 characters, or whitespace/commas.
LOCALAI_API_KEY=change-me-generate-with-openssl-rand-hex-32
