# Static LocalAI settings of the Quadlet deployment: the same set as ../stack/compose.yaml, in an env file because a
# JSON value needs no quoting here. No secret in this file (the API key is in alixai.env). Install as
# ~/.config/alixai/localai.env. tests/deploy checks that every off switch below is present and never switched on.
LOCALAI_SUBTLE_KEY_COMPARISON=true
LOCALAI_AUTH=false
LOCALAI_ADDRESS=:8080
LOCALAI_CORS=false
LOCALAI_MODELS_PATH=/models
LOCALAI_BACKENDS_PATH=/backends
LOCALAI_DATA_PATH=/data
LOCALAI_CONFIG_DIR=/configuration
LOCALAI_MODELS_CONFIG_FILE=/configuration/models.yaml
LOCALAI_BACKEND_GALLERIES=[{"name":"alixai-pinned","url":"file:///backends/alixai-backend-gallery.yaml"}]
LOCALAI_EXTERNAL_BACKENDS=cpu-llama-cpp
LOCALAI_AUTO_UPGRADE_BACKENDS=false
LOCALAI_REQUIRE_BACKEND_INTEGRITY=false
LOCALAI_DISABLE_WEBUI=true
LOCALAI_DISABLE_RUNTIME_SETTINGS=true
LOCALAI_DISABLE_GALLERY_ENDPOINT=true
LOCALAI_GALLERIES=[]
LOCALAI_AUTOLOAD_GALLERIES=false
LOCALAI_AUTOLOAD_BACKEND_GALLERIES=false
LOCALAI_DISABLE_MCP=true
LOCALAI_DISABLE_AGENTS=true
LOCALAI_DISABLE_ASSISTANT=true
LOCALAI_P2P=false
LOCALAI_FEDERATED=false
LOCALAI_DISTRIBUTED=false
LOCALAI_ENABLE_TRACING=false
LOCALAI_MAX_ACTIVE_BACKENDS=2
LOCALAI_WATCHDOG_IDLE=true
LOCALAI_WATCHDOG_IDLE_TIMEOUT=15m
LOCALAI_LOG_LEVEL=info
ALIXAI_MODELS_READONLY=true
