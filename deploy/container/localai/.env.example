# Copy to .env (git-ignored) and edit. Compose reads it for variable interpolation only;
# nothing here is forwarded to the container except through the entries in compose.yaml.

# REQUIRED. The single shared key AlixAI uses to call LocalAI; a legacy LocalAI key is full admin.
# Generate one:  openssl rand -hex 32
# entrypoint.sh refuses to start with this placeholder, a value under 32 characters, or whitespace/commas.
LOCALAI_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Backends installed at first boot: comma-separated names from config/backend-gallery.yaml.
LOCALAI_EXTERNAL_BACKENDS=cpu-llama-cpp

# Backends kept resident at once (LRU eviction beyond that). Leave it unset: each profile file carries its own
# default (compose.lite.yaml 2, compose.balanced.yaml 4, compose.4g.yaml 1, compose.yaml alone 2), and a value
# here would override all of them. Never set it below the models your AlixAI configuration keeps resident:
# with fewer active backends than resident models every call reloads one (docs/operations/resource-budgets.md
# R3). `alixai serve` refuses such a value when it sees the variable in its own environment.
# LOCALAI_MAX_ACTIVE_BACKENDS=2

# Unload an idle backend after this long (Go duration).
LOCALAI_WATCHDOG_IDLE_TIMEOUT=15m

# Upstream strict backend integrity. Leave false: v4.10.0 only accepts Sigstore-bundle signatures and the
# pinned backend image carries the older cosign format, so true refuses the install (hardening.md section 4).
LOCALAI_REQUIRE_BACKEND_INTEGRITY=false
