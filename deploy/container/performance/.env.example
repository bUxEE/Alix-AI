# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env && openssl rand -hex 32

VLLM_API_KEY=change-me-use-openssl-rand-hex-32
LOCALAI_API_KEY=change-me-use-openssl-rand-hex-32

# Registry id and directory under ./data/models/<id>/
ALIXAI_MODEL_ID=gpt-oss-20b

# Per-model context cap (tokens). gpt-oss native 131072; qwen3-30b-a3b native 262144.
# Keep well below native until KV budget is measured.
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=64
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_PORT=8000
LOCALAI_PORT=8080
