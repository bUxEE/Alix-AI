{
  "name": "@alixai/vue",
  "version": "1.5.0",
  "description": "Optional Vue 3 UI kit for AlixAI: an embeddable chat panel and independently usable components that talk the AG-UI protocol directly. Ships as source (.vue + .scss); the host bundler compiles it.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bUxEE/Alix-AI.git",
    "directory": "ui/vue"
  },
  "homepage": "https://github.com/bUxEE/Alix-AI/tree/main/ui/vue#readme",
  "bugs": {
    "url": "https://github.com/bUxEE/Alix-AI/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "demo:build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "sass": "^1.106.1",
    "typescript": "~5.9.3",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "sideEffects": [
    "**/*.scss",
    "**/*.vue"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./dictation": {
      "types": "./src/dictation/index.ts",
      "import": "./src/dictation/index.ts"
    },
    "./styles": {
      "sass": "./src/styles/index.scss",
      "default": "./src/styles/index.scss"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!**/fixtures/**",
    "!**/.env*"
  ],
  "dependencies": {
    "@alixai/sdk": "workspace:*",
    "@alixai/voice-orb": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  }
}
