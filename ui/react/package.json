{
  "name": "@alixai/react",
  "version": "1.4.1",
  "description": "AlixAI UI kit for React: the AlixAI parts of a CopilotKit chat (confirmation sheet, citations, attachments, chart, table and form blocks, source health, settings) with design tokens, English and Italian text, and no cloud or telemetry.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bUxEE/Alix-AI.git",
    "directory": "ui/react"
  },
  "homepage": "https://github.com/bUxEE/Alix-AI/tree/main/ui/react#readme",
  "bugs": {
    "url": "https://github.com/bUxEE/Alix-AI/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./copilotkit": {
      "types": "./dist/copilotkit.d.ts",
      "import": "./dist/copilotkit.js"
    },
    "./dictation": {
      "types": "./dist/dictation/index.d.ts",
      "import": "./dist/dictation/index.js"
    },
    "./styles.scss": "./src/styles/index.scss",
    "./tokens.scss": "./src/styles/_tokens.scss",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "test": "vitest run",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "styles": "sass --no-source-map src/styles/index.scss dist/alixai.css",
    "dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@alixai/copilotkit-adapter": "workspace:*",
    "@alixai/sdk": "workspace:*",
    "@alixai/voice-orb": "workspace:*"
  },
  "peerDependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@copilotkit/react-core": ">=1.76.0",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@copilotkit/react-core": "1.76.0",
    "@copilotkit/react-ui": "1.76.0",
    "@copilotkit/runtime": "1.76.0",
    "@copilotkit/runtime-client-gql": "1.76.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "^30.1.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rxjs": "7.8.1",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "zod": "^3.25.76"
  },
  "peerDependenciesMeta": {
    "@copilotkit/react-core": {
      "optional": true
    }
  }
}
