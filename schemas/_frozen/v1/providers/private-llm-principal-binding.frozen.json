{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alixai:schema:providers:private-llm-principal-binding:v1",
  "title": "Principal private LLM binding (operator)",
  "description": "Operator activation of a principal's private endpoint for one or more roles (ADR 0045). The host activates the paid feature; the user does not.",
  "type": "object",
  "additionalProperties": false,
  "required": ["principal_id", "endpoint_id", "roles", "updated_at"],
  "properties": {
    "principal_id": {
      "x-alixai-authority": "host",
      "$ref": "urn:alixai:schema:common:ids:v1#/$defs/identifier"
    },
    "endpoint_id": {
      "x-alixai-authority": "host",
      "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/privateEndpointId"
    },
    "roles": {
      "x-alixai-authority": "host",
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/principalLlmRole" }
    },
    "lifecycle": {
      "x-alixai-authority": "alixai",
      "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/privateLlmLifecycle"
    },
    "updated_at": {
      "x-alixai-authority": "alixai",
      "$ref": "urn:alixai:schema:common:timestamps:v1#/$defs/timestamp"
    }
  }
}
