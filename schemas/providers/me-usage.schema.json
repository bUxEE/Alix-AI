{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alixai:schema:providers:me-usage:v1",
  "title": "Principal usage page",
  "description": "The caller's own external-provider usage across tenants of the application (ADR 0041, 1.3.0): groups by provider, role and UTC day with meter units and charged cost estimates. Never another principal's rows. Paginated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["groups", "next_cursor"],
  "properties": {
    "groups": {
      "description": "Usage groups oldest first within the page.",
      "x-alixai-authority": "alixai",
      "type": "array",
      "items": { "$ref": "#/$defs/group" }
    },
    "next_cursor": {
      "description": "The cursor of the next page, or null at the end.",
      "x-alixai-authority": "alixai",
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]{1,18}$" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "provider_id",
        "role",
        "toks_in",
        "toks_out",
        "audio_seconds_in",
        "characters_in",
        "requests",
        "currency",
        "charged_micro_units"
      ],
      "properties": {
        "day": {
          "description": "UTC calendar day the spend was charged to (YYYY-MM-DD).",
          "x-alixai-authority": "alixai",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "provider_id": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/providerId"
        },
        "role": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/role"
        },
        "tenant_id": {
          "description": "Present when the page was filtered to one tenant; otherwise omitted (groups may span tenants).",
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:common:ids:v1#/$defs/identifier"
        },
        "toks_in": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/counter"
        },
        "toks_out": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/counter"
        },
        "audio_seconds_in": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/counter"
        },
        "characters_in": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/counter"
        },
        "web_searches": {
          "description": "Native web search tool calls (ADR 0050).",
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/counter"
        },
        "requests": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/counter"
        },
        "currency": {
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/currency"
        },
        "charged_micro_units": {
          "description": "What the budgets were charged for the group (integer micro-units).",
          "x-alixai-authority": "alixai",
          "$ref": "urn:alixai:schema:providers:shared:v1#/$defs/microUnits"
        }
      }
    }
  }
}
